# Configuración de Gemini Developer API
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash

# Configuración de Google Cloud Platform (GCP)
GCP_PROJECT_ID=tu_project_id_aqui
GCP_PROJECT_NUMBER=tu_project_number_aqui
GOOGLE_APPLICATION_CREDENTIALS=private/gcp-sa.json

# Configuración de ejecución local
APP_HOST=127.0.0.1
APP_PORT=8501
ENVIRONMENT=local
LOG_LEVEL=INFO
