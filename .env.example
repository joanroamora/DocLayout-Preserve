# Configuración de Gemini Developer API
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RPM=30

# Configuración de Google Cloud Platform (GCP)
GCP_PROJECT_ID=tu_project_id_aqui
GCP_PROJECT_NUMBER=tu_project_number_aqui
GOOGLE_APPLICATION_CREDENTIALS=private/gcp-sa.json

# Configuración de ejecución local y API Gateway
APP_HOST=127.0.0.1
APP_PORT=8501
API_HOST=127.0.0.1
API_PORT=8000
WORKER_HEALTH_PORT=8081
ENVIRONMENT=local
LOG_LEVEL=INFO

# Cola asíncrona y almacenamiento cifrado con TTL
REDIS_URL=
ARTIFACT_STORE_DIR=.tmp/artifacts
ARTIFACT_TTL_SECONDS=3600
ARTIFACT_ENCRYPTION_SECRET=
MAX_CONCURRENT_JOBS_PER_SESSION=5
